# Copy this file to .env and fill in your keys. NEVER commit .env!

# --- LLM Settings ---
# Option A: Google Gemini via OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# Option B: Groq (uncomment if using Groq)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b

# Optional: Fallback models (comma-separated) to try if primary model fails/rate-limits
LLM_FALLBACK=
# Optional: Reasoning effort (e.g. none, low, medium, high)
LLM_REASONING=none

# --- Gnani Voice AI (STT & TTS) ---
GNANI_API_KEY=
STT_LANG=en-IN
TTS_VOICE=Kaveri
TTS_MODEL=timbre-v2.5

# --- Dataset Directory ---
# Optional: custom path to dataset folder (defaults to local folder if omitted)
# DATASET_DIR=./Capstone_Project_Dataset_FTTT_2026
